    |                                                                      |
    |   options : [ AFTER "x" [EXACT] [ONLY] | BEFORE "x" [EXACT] [ONLY] ] |
    |             [ IFNEW | ALWAYS ]                                       |
    |             [ *ID ]                                                  |
    |             [ RS(x) ]                                                |
    |             [ IF "x" [EXACT] ]                                       |
    |             [ IFNOT "x" [EXACT] ]                                    |
