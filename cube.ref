    |                                                                      |
    |   options : [ ALL | FIRST | LAST ]                                   |
    |             [ *ID ]                                                  |
    |             [ IF "x" [EXACT] ]                                       |
    |             [ IFNOT "x" [EXACT] ]                                    |
    +----------------------------------------------------------------------+
    |   DelLine lineid [EXACT] [ (options[)] ]                             |
    |                                                                      |
    |   options : [ ALL | FIRST | LAST ]                                   |
    |             [ *ID ]                                                  |
    |             [ RS(x) ]                                                |
    |             [ IF "x" [EXACT] ]                                       |
    |             [ IFNOT "x" [EXACT] ]                                    |
    +----------------------------------------------------------------------+
