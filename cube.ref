    |                                                                      |
    |   options:  [ ALL | FIRST | LAST ]                                   |
    |             [ ADDTOP | ADDBOTTOM | DONTADD ]                         |
    |             [ *ID ]                                                  |
    |             [ RS(x) ]                                                |
    |             [ IF "x" [EXACT] ]                                       |
    |             [ IFNOT "x" [EXACT] ]                                    |
    +----------------------------------------------------------------------+
    |   AddString string IN lineid [EXACT] (options[)]                     |
    |                                                                      |
